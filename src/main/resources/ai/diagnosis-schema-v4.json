{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["diagnosed", "insufficient_evidence"]
    },
    "root_cause_code": {
      "type": ["string", "null"],
      "enum": [
        "PAYMENT_TIMEOUT_CONFIG",
        "INVENTORY_SCHEMA_MISMATCH",
        "CHECKOUT_DB_POOL_EXHAUSTION",
        "CATALOG_CACHE_INVALIDATION_FAILURE",
        "ORDER_EVENT_CONSUMER_BACKLOG",
        "ORDER_IDEMPOTENCY_FAILURE",
        null
      ]
    },
    "affected_service": {
      "type": ["string", "null"],
      "enum": [
        "PAYMENT_ADAPTER",
        "INVENTORY_SERVICE",
        "CHECKOUT_API",
        "CATALOG_SERVICE",
        "ORDER_EVENT_CONSUMER",
        "ORDER_SERVICE",
        null
      ]
    },
    "business_summary": {"type": "string"},
    "technical_summary": {"type": "string"},
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_code": {
            "type": "string",
            "enum": [
              "root_cause",
              "affected_service",
              "trigger",
              "customer_impact",
              "observed_symptom",
              "missing_evidence"
            ]
          },
          "claim_value_code": {
            "type": "string",
            "enum": [
              "PAYMENT_TIMEOUT_CONFIG",
              "INVENTORY_SCHEMA_MISMATCH",
              "CHECKOUT_DB_POOL_EXHAUSTION",
              "CATALOG_CACHE_INVALIDATION_FAILURE",
              "ORDER_EVENT_CONSUMER_BACKLOG",
              "ORDER_IDEMPOTENCY_FAILURE",
              "PAYMENT_ADAPTER",
              "INVENTORY_SERVICE",
              "CHECKOUT_API",
              "CATALOG_SERVICE",
              "ORDER_EVENT_CONSUMER",
              "ORDER_SERVICE",
              "PAYMENT_ADAPTER_RELEASE",
              "INVENTORY_SERVICE_RELEASE",
              "CHECKOUT_POOL_CONFIG_CHANGE",
              "CHECKOUT_TRANSACTION_REGRESSION",
              "CATALOG_INVALIDATION_CONFIG_CHANGE",
              "ORDER_CONSUMER_CONFIG_CHANGE",
              "ORDER_CONSUMER_POISON_EVENT",
              "ORDER_CONSUMER_REBALANCE",
              "ORDER_IDEMPOTENCY_POLICY_CHANGE",
              "ORDER_IDEMPOTENCY_STORAGE_CHANGE",
              "CHECKOUT_PAYMENT_FAILURES",
              "MULTI_ITEM_CHECKOUT_FAILURES",
              "CHECKOUT_REQUEST_FAILURES",
              "STALE_CATALOG_RESULTS",
              "ORDER_PROCESSING_DELAYS",
              "DUPLICATE_ORDERS",
              "PAYMENT_LATENCY_SPIKE",
              "INVENTORY_CONTRACT_VALIDATION_ERRORS",
              "DATABASE_POOL_WAIT_SPIKE",
              "CATALOG_VERSION_DIVERGENCE",
              "ORDER_CONSUMER_LAG",
              "DUPLICATE_ORDER_CREATION",
              "PAYMENT_PROVIDER_RESPONSE",
              "PAYMENT_TIMEOUT_CONFIG_AUDIT",
              "CATALOG_SOURCE_OF_TRUTH_VERSION",
              "CATALOG_TAX_CALCULATION_TRACE"
            ]
          },
          "display_text": {"type": "string"},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "string"}
          }
        },
        "required": [
          "claim_code",
          "claim_value_code",
          "display_text",
          "evidence_ids"
        ]
      }
    },
    "safe_next_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string"},
        "requires_human_approval": {"type": "boolean"}
      },
      "required": ["summary", "requires_human_approval"]
    }
  },
  "required": [
    "status",
    "root_cause_code",
    "affected_service",
    "business_summary",
    "technical_summary",
    "claims",
    "safe_next_step"
  ]
}
